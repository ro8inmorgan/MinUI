#!/bin/sh

# NOTE: becomes .tmp_update/updater

INFO=$(cat /proc/cpuinfo 2>/dev/null)
PLATFORM=""
case "$INFO" in
*"sun8i"*)
	if [ -d /usr/miyoo ]; then PLATFORM="my282"; else PLATFORM="trimuismart"; fi
	;;
*"SStar"*) PLATFORM="miyoomini" ;;
*"TG5040"*|*"TG3040"*|*"TG4040"*) PLATFORM="tg5040" ;;
*"TG5050"*) PLATFORM="tg5050" ;;
*"0xd03"*) PLATFORM="zero28" ;;
*"0xd05"*) PLATFORM="my355" ;;
esac

# fallback for tg5040 20240413 recovery firmware
if [ -z "$PLATFORM" ] && [ -f /usr/trimui/bin/runtrimui.sh ]; then
	PLATFORM="tg5040"
fi

case "$PLATFORM" in
tg5040|tg5050|my282|trimuismart|miyoomini|zero28|my355) ;;
*) printf '%s\n' "NextUI updater: unsupported platform" >&2; exit 1 ;;
esac

UPDATER="/mnt/SDCARD/.tmp_update/$PLATFORM.sh"
[ -x "$UPDATER" ] || { printf '%s\n' "NextUI updater: missing executable $UPDATER" >&2; exit 1; }
"$UPDATER"
status=$?
[ "$status" -eq 0 ] || { printf '%s\n' "NextUI updater: $PLATFORM failed ($status)" >&2; exit "$status"; }

# Only a successful platform updater may request shutdown.
echo s > /proc/sysrq-trigger
echo u > /proc/sysrq-trigger
echo o > /proc/sysrq-trigger
